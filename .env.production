# ==========================================================
# DJANGO - PRODUCTION
# ==========================================================

DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production

# Généré automatiquement par deploy.sh au premier déploiement
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False

# Ces 3 valeurs seront injectées par deploy.sh à partir
# du domaine passé au script.
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=


# ==========================================================
# POSTGRESQL / POSTGIS
# ==========================================================

POSTGRES_DB=whatassoh_db
POSTGRES_USER=whatassoh

# Généré automatiquement une seule fois par deploy.sh
POSTGRES_PASSWORD=

# IMPORTANT :
# Dans Docker, ce n'est PAS localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ==========================================================
# REDIS
# ==========================================================

# Généré automatiquement une seule fois par deploy.sh
REDIS_PASSWORD=

# Ces URLs seront construites automatiquement par deploy.sh
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=


# ==========================================================
# SENTRY
# ==========================================================

SENTRY_DSN=


# ==========================================================
# WHATSAPP / META
# ==========================================================

# On laisse désactivé tant que les vrais credentials
# de production ne sont pas configurés.
WHATSAPP_ENABLED=False

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

WHATSAPP_REQUEST_TIMEOUT=10

META_GRAPH_API_VERSION=v26.0

WHATSAPP_TEMPLATE_LANGUAGE_CODE=fr

WHATSAPP_TEMPLATE_ORDER_UPDATE=
WHATSAPP_TEMPLATE_ORDER_ACTION_REQUIRED=
WHATSAPP_TEMPLATE_OPERATIONAL_ACTION_REQUIRED=


# ==========================================================
# TELEGRAM
# ==========================================================

# Même principe : activation uniquement lorsque
# le token de production est configuré.
TELEGRAM_ENABLED=False

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_REQUEST_TIMEOUT=10